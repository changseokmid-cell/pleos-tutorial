<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <application android:name=".GuideApplication" android:label="내 차 사용 안내" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <receiver android:name=".GleoReceiver" android:exported="true">
            <intent-filter>
                <action android:name="SET_TUTORIAL_MODE" />
                <action android:name="START_FEATURE_GUIDE" />
                <action android:name="RESPOND_TO_GUIDE" />
            </intent-filter>
        </receiver>
        <service android:name=".TutorialService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>
